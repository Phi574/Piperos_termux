# PiperOS runtime identity. These values are part of the binary ABI.
PIPEROS_APP_PACKAGE_NAME=com.piper.os.tool
PIPEROS_APP_NAME=PiperOS
PIPEROS_MIN_API=24
PIPEROS_RUNTIME_VERSION=2.5.0-beta.1
PIPEROS_APT_REPOSITORY_URL=https://phi574.github.io/Piperos_termux
PIPEROS_APT_SUITE=stable
PIPEROS_APT_COMPONENT=main
PIPEROS_APT_KEY_FINGERPRINT=322CE397F439E57D589FC2EC700F86804882BE7E

# Pin upstream for reproducible builds. Update deliberately through review.
TERMUX_PACKAGES_REPOSITORY=https://github.com/termux/termux-packages.git
TERMUX_PACKAGES_COMMIT=965236e7d55bc36b93711cc52e21fb2f8ec2d03e

# Android ABI list exposed to PiperOS.
PIPEROS_ANDROID_ABIS=arm64-v8a,armeabi-v7a,x86_64
